{{#each erros}}

  <div class="alert-danger">{{texto}}</div>

{{/each}}

<div class="p-5 mb-4 bg-light rounded-3">
  <div class="container-fluid py-5">
    <h1 class="display-5 fw-bold">Bem-vindo ao blog node!</h1>
    <p class="col-md-8 fs-4">Esse é um exemplo de um jumbotron feito com Bootstrap 5.</p>
    <button class="btn btn-primary btn-lg" type="button">Crie uma conta</button>
  </div>
</div>

<hr>

<h2>Postagens recentes</h2>

{{#each postagens}}
<div class="card mt-4"></div>
    <div class="card-body mt-2">
      
        <h3>{{titulo}}</h3>
        <p>{{descricao}}</p>
        <a href="/postagem/{{slug}}"><button class="btn btn-success">Leia mais</button></a>
        <hr>
        <small>Categoria: {{categoria.nome}}</small><br>
        <small>Data de publicação: {{categoria.date}}</small>
        
    </div>
</div>
{{else}}
    <h5>Nenhuma postagem existente.</h5>
{{/each}}